{
  "name": "openframe",
  "version": "1.0.0",
  "description": "Professional cross-platform media player and processor powered by LibVLC and FFmpeg",
  "main": "src/main/main.js",
  "homepage": "./",
  "author": "OpenFrame Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:mac": "electron-builder --mac",
    "dist": "npm run build && electron-builder",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "@reduxjs/toolkit": "^1.9.0",
    "react-redux": "^8.0.0",
    "styled-components": "^6.0.0",
    "axios": "^1.3.0",
    "lodash": "^4.17.21",
    "uuid": "^9.0.0",
    "moment": "^2.29.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.0.0",
    "node-vlc": "^0.3.0",
    "fluent-ffmpeg": "^2.1.2",
    "node-ffmpeg": "^0.6.2"
  },
  "devDependencies": {
    "electron-builder": "^24.6.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.11.0",
    "html-webpack-plugin": "^5.5.0",
    "babel-loader": "^9.1.0",
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.18.0",
    "css-loader": "^6.7.0",
    "style-loader": "^3.3.0",
    "file-loader": "^6.2.0",
    "url-loader": "^4.1.1",
    "concurrently": "^7.6.0",
    "eslint": "^8.30.0",
    "eslint-plugin-react": "^7.31.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.3.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^5.16.0"
  },
  "build": {
    "appId": "com.openframe.app",
    "productName": "OpenFrame",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": ".",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "msi",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "OpenFrame",
      "verifyUpdateCodeSignature": false,
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenFrame",
      "include": "build/installer.nsh"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenFrame",
      "menuCategory": "OpenFrame",
      "installerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": [
        "com.apple.security.cs.allow-jit"
      ],
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "OpenFrame uses the Documents folder to access media files",
        "NSDownloadsFolderUsageDescription": "OpenFrame uses the Downloads folder to access media files"
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        },
        {
          "target": "snap",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "desktop": {
        "Name": "OpenFrame",
        "Comment": "Professional Media Player and Processor",
        "Keywords": "media;player;video;audio;ffmpeg;vlc;converter;recorder;"
      }
    }
  }
}
